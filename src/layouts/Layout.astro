    <meta name="theme-color" content="#FAF8F5" />
    <meta name="keywords" content="audio to text, transcription, speech to text, audio transcription, chrome extension, voice to text, audio converter, meeting transcription, interview transcription, podcast transcription" />
    <meta name="author" content="Audio To Text Transcription" />
    
    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
