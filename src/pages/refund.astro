---
import Layout from '../layouts/Layout.astro';
import NavigationBar from '../components/NavigationBar.vue';
import AppFooter from '../components/AppFooter.vue';

const title = 'Refund Policy - Audio To Text Transcription';
const description = '30-day money-back guarantee and refund process for Audio To Text Transcription.';
---

<Layout title={title} description={description}>
  <NavigationBar client:load />
  <main class="privacy-page">
    <article class="privacy-card">
      <header class="privacy-card-header">
        <h1>Refund Policy</h1>
        <p class="updated">Last Updated: September 15, 2026</p>
      </header>

      <section>
        <h2>Introduction</h2>
        <p>Thank you for using Audio To Text Transcription, operated under Kobaltstack LLC. We want you to have a good experience with the Service, and this policy explains how refunds and cancellations work.</p>
        <p>By making a purchase through Audio To Text Transcription, you agree to this Refund Policy along with our Terms of Service and Privacy Policy.</p>
        <p>If you're not satisfied with the Service for any reason, please contact us first — we're happy to help resolve the issue.</p>
        <p>Kobaltstack LLC is located at 447 Broadway, 2nd Floor, 3436, New York, NY 10013, New York, US.</p>
      </section>

      <section>
        <h2>30-Day Money-Back Guarantee</h2>
        <p>We offer a 30-day money-back guarantee on paid subscriptions and one-time minute-pack purchases. You may request a full refund within 30 days of the relevant charge — no questions asked. Refunds are issued to the original payment method, and we aim to process them within 7 business days of receiving your request. The time it takes to appear on your bank or card statement can vary by provider.</p>
        <p>Your statutory consumer rights — including any withdrawal or cancellation periods required under the laws of your country of residence — are unaffected by this policy and always take precedence over it.</p>
      </section>

      <section>
        <h2>Subscriptions</h2>
        <p>You can cancel your subscription at any time. Cancellation takes effect at the end of your current billing period, and you'll retain access to Audio To Text Transcription until then. Cancellation does not by itself refund a past charge. The 30-day money-back guarantee above remains available; outside that guarantee, no partial refunds are issued for unused time within a billing period, unless required by law.</p>
        <p>If you believe you were charged after cancelling, please contact us at <a href="mailto:support@audio-to-text-transcription.com">support@audio-to-text-transcription.com</a> and we'll resolve it.</p>
      </section>

      <section>
        <h2>Free plans and trials</h2>
        <p>Features or plans marked as "Free" do not involve a monetary transaction and are therefore not subject to refunds.</p>
      </section>

      <section>
        <h2>How to request a refund</h2>
        <p>To request a refund, email us at <a href="mailto:support@audio-to-text-transcription.com">support@audio-to-text-transcription.com</a> with your order details (email used at purchase and approximate date; a reason is optional and is not required). We aim to respond within 2 business days.</p>
      </section>

      <section>
        <h2>Exceptions</h2>
        <p>We may decline a refund request where there is evidence of fraud, abuse of this policy, or other manipulative behavior.</p>
        <p>If you purchased through a third-party platform (for example, the Chrome Web Store or another app marketplace), that platform's own refund policy governs your purchase instead of this one.</p>
      </section>

      <section>
        <h2>Contact us</h2>
        <p>Questions about this Refund Policy can be directed to: <a href="mailto:support@audio-to-text-transcription.com">support@audio-to-text-transcription.com</a></p>
      </section>
    </article>
  </main>
  <AppFooter client:load />
</Layout>

<style>
  .privacy-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 48px 16px 120px;
    gap: 32px;
    background: var(--gradient-bg);
  }

  .privacy-card {
    width: 100%;
    max-width: 960px;
    background: var(--color-surface-elevated);
    border-radius: 28px;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-xl);
    padding: 48px clamp(24px, 4vw, 56px);
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .privacy-card-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .privacy-card-header h1 {
    font-size: clamp(2.5rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--color-text);
    margin: 0;
  }

  .updated {
    font-size: 1rem;
    color: var(--color-text-secondary);
  }

  .privacy-card section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .privacy-card h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
  }

  .privacy-card p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
  }

  .privacy-card a {
    color: var(--accent-primary);
    text-decoration: none;
  }

  .privacy-card a:hover,
  .privacy-card a:focus-visible {
    color: var(--accent-primary-hover);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .privacy-page {
      padding-top: 24px;
    }

    .privacy-card {
      border-radius: 20px;
      padding: 36px 20px;
      gap: 32px;
    }

    .privacy-card p {
      font-size: 1rem;
      line-height: 1.7;
    }
  }
</style>
